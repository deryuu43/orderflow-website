# APP_URL: URL aplikasi saat dijalankan di Cloud Run / environment lokal.
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL Runtime Connection (Object Method - disediakan otomatis oleh platform)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""

# Cloud SQL PostgreSQL Admin Credentials (khusus migrasi skema via Drizzle Kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Simulasi Webhook Secret untuk verifikasi signature pembayaran langganan SaaS
SUBSCRIPTION_WEBHOOK_SECRET="orderflow_sim_secret_key"

# GEMINI_API_KEY: Disediakan otomatis oleh AI Studio runtime bila dibutuhkan
GEMINI_API_KEY=""
